+/**
+ * Get cumulative paid leave balance across all historical records
+ * Formula: availableBalance = totalPaidCredited - totalPaidUsed
+ */
+export async function getCumulativePaidBalance(employeeId) {
+  const result = await pool.query(
+    `SELECT
+       COALESCE(SUM(paid_leave_credited), 0) AS total_paid_credited,
+       COALESCE(SUM(paid_leave_used), 0) AS total_paid_used
+     FROM leave_balance
+     WHERE user_id = $1`,
+    [employeeId]
+  );
+
+  const row = result.rows[0];
+  const totalCredited = Number(row.total_paid_credited || 0);
+  const totalUsed = Number(row.total_paid_used || 0);
+  const availableBalance = Math.max(0, totalCredited - totalUsed);
+
+  return {
+    total_paid_credited: totalCredited,
+    total_paid_used: totalUsed,
+    available_balance: availableBalance,
+  };
+}
+
+/**
+ * Accrue monthly paid leave with target balance enforcement
+ * Target balance: 1 day per month
+ * Formula: monthlyCredit = Math.max(0, 1 - availableBalance)
+ */
+export async function accrueMonthlyLeaveWithTargetBalance(employeeId, asOf = new Date()) {
+  const client = await pool.connect();
+  
+  try {
+    await client.query("BEGIN");
+
+    // Check employee eligibility
+    const userRes = await client.query(
+      `SELECT id, COALESCE(joining_date, DATE(created_at)) AS joining_date, status
+       FROM users WHERE id = $1`,
+      [employeeId]
+    );
+    
+    if (!userRes.rows.length || userRes.rows[0].status !== "active") {
+      await client.query("ROLLBACK");
+      return { accrued: false, reason: "user_not_found_or_inactive" };
+    }
+
+    const joiningDate = userRes.rows[0].joining_date;
+    const eligible = await isEligibleForPaidLeave(joiningDate, asOf);
+    
+    if (!eligible) {
+      await client.query("ROLLBACK");
+      return {
+        accrued: false,
+        reason: "probation_not_complete",
+        monthsCompleted: monthsSinceJoining(joiningDate, asOf),
+      };
+    }
+
+    const { perMonth } = await getPaidLeavePolicy();
+    const year = asOf.getFullYear();
+    const month = asOf.getMonth() + 1;
+    const todayStr = asOf.toISOString().slice(0, 10);
+
+    // Check if already accrued this month (idempotency)
+    const existing = await client.query(
+      `SELECT id, accrual_date, last_accrual_date
+       FROM leave_balance
+       WHERE user_id = $1 AND year = $2 AND month = $3
+       FOR UPDATE`,
+      [employeeId, year, month]
+    );
+
+    const accrualMark =
+      existing.rows[0]?.accrual_date || existing.rows[0]?.last_accrual_date;
+    
+    if (
+      existing.rows.length &&
+      accrualMark &&
+      String(accrualMark).slice(0, 7) === `${year}-${String(month).padStart(2, "0")}`
+    ) {
+      await client.query("ROLLBACK");
+      const cumulative = await getCumulativePaidBalance(employeeId);
+      return { 
+        accrued: false, 
+        reason: "already_accrued_this_month", 
+        balance: cumulative.available_balance 
+      };
+    }
+
+    // Calculate cumulative balance across all history
+    const cumulative = await getCumulativePaidBalance(employeeId);
+    const availableBalance = cumulative.available_balance;
+
+    // Apply target balance formula
+    const monthlyCredit = Math.max(0, perMonth - Math.max(0, availableBalance));
+
+    if (monthlyCredit <= 0) {
+      await client.query("ROLLBACK");
+      return {
+        accrued: false,
+        reason: "target_balance_already_met",
+        existing_balance: availableBalance,
+        monthly_credit: 0,
+      };
+    }
+
+    // Credit the calculated amount
+    await client.query(
+      `INSERT INTO leave_balance
+         (user_id, year, month,
+          sick_credited, sick_used,
+          casual_credited, casual_used,
+          paid_leave_credited, paid_leave_used,
+          unpaid_leave_used, accrual_date, last_accrual_date, updated_at)
+       VALUES ($1, $2, $3, 0, 0, 0, 0, $4, 0, 0, $5, $5, NOW())
+       ON CONFLICT (user_id, year, month) DO UPDATE SET
+         paid_leave_credited = COALESCE(leave_balance.paid_leave_credited, 0) + EXCLUDED.paid_leave_credited,
+         accrual_date = EXCLUDED.accrual_date,
+         last_accrual_date = EXCLUDED.last_accrual_date,
+         updated_at = NOW()`,
+      [employeeId, year, month, monthlyCredit, todayStr]
+    );
+
+    await client.query("COMMIT");
+
+    const newCumulative = await getCumulativePaidBalance(employeeId);
+    return {
+      accrued: true,
+      added: monthlyCredit,
+      previous_balance: availableBalance,
+      new_balance: newCumulative.available_balance,
+      target_balance: perMonth,
+    };
+  } catch (err) {
+    await client.query("ROLLBACK");
+    throw err;
+  } finally {
+    client.release();
+  }
+}
